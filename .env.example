# Copia questo file in .env e compila i valori:
#   cp .env.example .env
# Il file .env NON viene versionato (contiene i segreti).

# --- Database PostgreSQL ---
DB_USER=webserver
DB_PASSWORD=cambia-questa-password
DB_NAME=webserver

# --- Autenticazione pagina web ---
AUTH_USERNAME=admin
AUTH_PASSWORD=cambia-questa-password
# Stringa casuale lunga usata per firmare i cookie di sessione.
# Generane una con:  openssl rand -hex 32
SESSION_SECRET=metti-qui-una-stringa-casuale-lunga

# Metti true solo se la pagina è servita SEMPRE via HTTPS
# (es. dietro un reverse proxy con certificato SSL).
COOKIE_SECURE=false
