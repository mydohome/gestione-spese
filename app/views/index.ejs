<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0f1220">
  <title>Le mie spese</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="shell">
    <aside class="sidebar">
      <div class="brand">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6c8cff"/><stop offset="1" stop-color="#12b886"/></linearGradient></defs>
          <rect width="40" height="40" rx="11" fill="url(#lg)"/>
          <path d="M8 26c4 0 4-6 8-6s4 8 8 8 4-12 10-12" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/>
          <circle cx="28" cy="14" r="3.4" fill="#fff"/>
        </svg>
        <span>Le mie spese</span>
      </div>
      <nav class="nav" aria-label="Sezioni">
        <button type="button" class="nav-link" data-view="dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="10" rx="1.5"/><rect x="3" y="17" width="8" height="4" rx="1.5"/><rect x="13" y="3" width="8" height="4" rx="1.5"/><rect x="13" y="11" width="8" height="10" rx="1.5"/></svg>
          <span>Dashboard</span>
        </button>
        <button type="button" class="nav-link" data-view="movimenti">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r="1.4"/><circle cx="3.5" cy="12" r="1.4"/><circle cx="3.5" cy="18" r="1.4"/></svg>
          <span>Movimenti</span>
        </button>
        <button type="button" class="nav-link" data-view="categorie">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V4a1 1 0 0 1 1-1h9l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="8" cy="8" r="1.6"/></svg>
          <span>Categorie</span>
        </button>
        <button type="button" class="nav-link" data-view="conti">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H5a2 2 0 0 1 0-4h13v4Z"/><path d="M4 7v11a2 2 0 0 0 2 2h13a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1"/><circle cx="16" cy="13" r="1.3"/></svg>
          <span>Conti</span>
        </button>
        <button type="button" class="nav-link" data-view="backup">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
          <span>Backup</span>
        </button>
      </nav>
      <div class="nav-spacer"></div>
      <button type="button" class="nav-link" id="logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <span>Esci</span>
      </button>
    </aside>

    <main class="main">
      <header class="topbar-m">
        <div class="brand">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <defs><linearGradient id="lg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6c8cff"/><stop offset="1" stop-color="#12b886"/></linearGradient></defs>
            <rect width="40" height="40" rx="11" fill="url(#lg2)"/>
            <path d="M8 26c4 0 4-6 8-6s4 8 8 8 4-12 10-12" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/>
            <circle cx="28" cy="14" r="3.4" fill="#fff"/>
          </svg>
          <span>Le mie spese</span>
        </div>
        <button type="button" class="btn ghost" id="logout-m" aria-label="Esci">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </header>

      <div class="page-head">
        <div>
          <h1 id="page-title">Dashboard</h1>
          <p id="page-sub">Il tuo quadro spese</p>
        </div>
        <div class="segment" id="scope-switch" role="tablist" aria-label="Ambito">
          <button type="button" class="tab active" data-scope="personal" role="tab" aria-selected="true">Personali</button>
          <button type="button" class="tab" data-scope="home" role="tab" aria-selected="false">Casa</button>
          <button type="button" class="tab" data-scope="all" role="tab" aria-selected="false">Totale</button>
        </div>
      </div>

      <!-- ============ DASHBOARD ============ -->
      <section data-view="dashboard">
        <div class="grid cols-3">
          <article class="card stat expense">
            <span class="label">Oggi</span>
            <span class="value" id="sum-day">—</span>
            <span class="sub">entrate <b id="sum-day-in">—</b> · saldo <b class="bal" id="sum-day-bal">—</b></span>
          </article>
          <article class="card stat expense">
            <span class="label">Questa settimana</span>
            <span class="value" id="sum-week">—</span>
            <span class="sub">entrate <b id="sum-week-in">—</b> · saldo <b class="bal" id="sum-week-bal">—</b></span>
          </article>
          <article class="card stat expense">
            <span class="label">Questo mese</span>
            <span class="value" id="sum-month">—</span>
            <span class="sub">entrate <b id="sum-month-in">—</b> · saldo <b class="bal" id="sum-month-bal">—</b></span>
          </article>
        </div>

        <section class="card card-pad split" id="split-panel" hidden aria-label="Personali e Casa a confronto">
          <h3>Personali e Casa a confronto</h3>
          <div class="split__grid">
            <div class="split__cell">
              <span class="split__label">Personali · mese</span>
              <span class="split__val" id="split-personal-month">—</span>
              <span class="split__sub">complessivo <b id="split-personal-total">—</b></span>
            </div>
            <div class="split__cell">
              <span class="split__label">Casa · mese</span>
              <span class="split__val" id="split-home-month">—</span>
              <span class="split__sub">complessivo <b id="split-home-total">—</b></span>
            </div>
            <div class="split__cell split__cell--sum">
              <span class="split__label">Totale · mese</span>
              <span class="split__val" id="split-all-month">—</span>
              <span class="split__sub">complessivo <b id="split-all-total">—</b></span>
            </div>
          </div>
        </section>

        <div class="charts">
          <article class="card card-pad chart-card">
            <h3>Ultimi 30 giorni</h3>
            <div class="chart-box"><canvas id="chart-daily"></canvas></div>
          </article>
          <article class="card card-pad chart-card">
            <h3>Andamento mensile</h3>
            <div class="chart-box"><canvas id="chart-monthly"></canvas></div>
          </article>
        </div>
      </section>

      <!-- ============ MOVIMENTI ============ -->
      <section data-view="movimenti" hidden>
        <form class="card card-pad form" id="form">
          <div class="seg" role="group" aria-label="Tipo movimento">
            <input type="radio" name="kind" id="kind-expense" value="expense" checked>
            <label for="kind-expense">Spesa</label>
            <input type="radio" name="kind" id="kind-income" value="income">
            <label for="kind-income">Entrata</label>
          </div>
          <div class="field">
            <label for="date">Data</label>
            <input type="date" id="date" name="date" required>
          </div>
          <div class="field">
            <label for="amount">Importo (€)</label>
            <input type="number" id="amount" name="amount" step="0.01" min="0" inputmode="decimal" placeholder="0,00" required>
          </div>
          <div class="field field--grow">
            <label for="description">Descrizione</label>
            <input type="text" id="description" name="description" maxlength="500" placeholder="Es. Spesa supermercato / Stipendio">
          </div>
          <div class="field field--grow" id="cat-field-personal">
            <label for="category">Categoria <button type="button" class="mini-add" data-add="category">+ nuova</button></label>
            <select id="category" name="category" class="select"></select>
          </div>
          <div class="field field--grow" id="cat-field-home" hidden>
            <label for="category-home">Categoria <button type="button" class="mini-add" data-add="category">+ nuova</button></label>
            <select id="category-home" name="category-home" class="select"></select>
          </div>
          <div class="field field--grow" id="conto-field">
            <label for="account">Conto <button type="button" class="mini-add" data-add="account">+ nuovo</button></label>
            <select id="account" name="account" class="select"></select>
          </div>
          <button type="submit" class="btn primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Aggiungi
          </button>
        </form>
        <p class="model-note" id="model-note" hidden></p>

        <div class="list-head">
          <h2 class="section-title">Movimenti</h2>
          <span class="list-total" id="list-total"></span>
        </div>
        <div class="card tx-list" id="tx-list">
          <div class="empty">Caricamento…</div>
        </div>
      </section>

      <!-- ============ CATEGORIE ============ -->
      <section data-view="categorie" hidden>
        <article class="card card-pad chart-card">
          <h3>Spese per categoria</h3>
          <p class="hint">Mese corrente</p>
          <div class="chart-box"><canvas id="chart-categories"></canvas></div>
        </article>

        <div class="list-head">
          <h2 class="section-title">Gestione categorie</h2>
          <button type="button" class="btn primary" id="cat-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuova categoria
          </button>
        </div>
        <div class="card" id="cat-rows">
          <div class="empty">Caricamento…</div>
        </div>
      </section>

      <!-- ============ CONTI ============ -->
      <section data-view="conti" hidden>
        <article class="card card-pad chart-card">
          <h3>Spese per conto</h3>
          <p class="hint">Mese corrente</p>
          <div class="chart-box"><canvas id="chart-accounts"></canvas></div>
        </article>

        <div class="list-head">
          <h2 class="section-title">Gestione conti</h2>
          <button type="button" class="btn primary" id="acct-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuovo conto
          </button>
        </div>
        <p class="hint" style="margin:0 2px 12px">Il conto è facoltativo: puoi associarlo a qualsiasi spesa, personale o di casa.</p>
        <div class="card" id="acct-rows">
          <div class="empty">Caricamento…</div>
        </div>
      </section>

      <!-- ============ BACKUP ============ -->
      <section data-view="backup" hidden>
        <div class="card card-pad backup">
          <div class="backup__head">
            <h3>Copie di sicurezza</h3>
            <span class="backup__status" id="backup-status">—</span>
          </div>
          <p class="backup__note">
            Export automatico ogni <b>lunedì alle 03:00</b> nella cartella
            <code>docker/webserver/backups/</code> (ultime 12 settimane).
            Il file <code>expenses-latest.csv</code> è sempre l'ultima copia.
          </p>
          <div class="backup__actions">
            <a class="btn" href="/api/export.csv">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Esporta CSV ora
            </a>
            <button type="button" class="btn" id="backup-run">Salva backup su disco</button>
            <label class="btn file-btn">
              Importa CSV…
              <input type="file" id="import-file" accept=".csv,text/csv" hidden>
            </label>
            <select id="import-mode" class="select">
              <option value="merge">Unisci (salta duplicati)</option>
              <option value="replace">Sostituisci tutto</option>
            </select>
          </div>
          <p class="backup__result" id="backup-result" hidden></p>
          <ul class="backup__list" id="backup-list"></ul>
        </div>
      </section>
    </main>

    <nav class="tabbar" aria-label="Sezioni">
      <button type="button" data-view="dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="10" rx="1.5"/><rect x="3" y="17" width="8" height="4" rx="1.5"/><rect x="13" y="3" width="8" height="4" rx="1.5"/><rect x="13" y="11" width="8" height="10" rx="1.5"/></svg>
        <span>Dashboard</span>
      </button>
      <button type="button" data-view="movimenti">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r="1.4"/><circle cx="3.5" cy="12" r="1.4"/><circle cx="3.5" cy="18" r="1.4"/></svg>
        <span>Movimenti</span>
      </button>
      <button type="button" data-view="categorie">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V4a1 1 0 0 1 1-1h9l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="8" cy="8" r="1.6"/></svg>
        <span>Categorie</span>
      </button>
      <button type="button" data-view="conti">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H5a2 2 0 0 1 0-4h13v4Z"/><path d="M4 7v11a2 2 0 0 0 2 2h13a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1"/><circle cx="16" cy="13" r="1.3"/></svg>
        <span>Conti</span>
      </button>
      <button type="button" data-view="backup">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
        <span>Backup</span>
      </button>
    </nav>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script src="/vendor/chart.umd.min.js"></script>
  <script src="/app.js"></script>
</body>
</html>
